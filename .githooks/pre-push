#!/usr/bin/env bash
#
# pre-push hook — runs the fast gate lane, which is the same script CI runs.
#
# Before this hook took this form it ran shellcheck and nothing else, while CI
# ran Gradle, CMake, Spotless and schema lint — so most CI failures were not
# reproducible before push. One script closes that gap, and adding a language
# cannot reopen it.
#
# Install: `git config core.hooksPath .githooks`
# (set up by ./scripts/dev/install-hooks.sh)
# Bypass once with: git push --no-verify
#
# See docs/polyglot/gate.md and docs/decisions/0004-defensive-gate-stack.md.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$REPO_ROOT" || exit 0

GATE="$REPO_ROOT/scripts/ci/gate.sh"
if [ ! -x "$GATE" ]; then
    echo "pre-push: $GATE missing or not executable — skipping the gate." >&2
    exit 0
fi

if "$GATE" fast; then
    exit 0
fi

cat >&2 <<'EOF'

pre-push: the fast gate lane failed (summary above).

  Reproduce:   scripts/ci/gate.sh fast
  See a lane:  scripts/ci/gate.sh fast --list
  Reference:   docs/polyglot/gate.md
  Bypass once: git push --no-verify

EOF
exit 1
